---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import { listDays, listDigests, loadDigest } from "../../../../lib/data";
export function getStaticPaths() {
  return listDays().flatMap(({ id, date }) => loadDigest(id, date).events.map((event) => ({ params: { digest: id, date, slug: event.slug } })));
}
const digests = listDigests();
const digest = loadDigest(Astro.params.digest!, Astro.params.date!);
const event = digest.events.find((item) => item.slug === Astro.params.slug)!;
const articles = event.article_ids.map((id) => digest.articles.find((article) => article.id === id)).filter(Boolean);
---
<BaseLayout title={event.title}>
  <Header digest={digest} digests={digests} />
  <main class="article-page">
    <a class="back-link" href={`${import.meta.env.BASE_URL}digest/${digest.digest_id}/${digest.date}/`}>← Вернуться к выпуску</a>
    <p class="eyebrow">{event.category} · важность {event.importance}/10</p>
    <h1>{event.title}</h1>
    <p class="article-lead">{event.brief}</p>
    <section><h2>Контекст</h2><p>{event.context}</p></section>
    <section><h2>Почему это важно</h2><p>{event.why_it_matters}</p></section>
    <section><h2>Подтвержденные факты</h2><ul>{event.facts.map((fact) => <li>{fact.text}</li>)}</ul></section>
    <section><h2>Источники</h2><div class="article-links">{articles.map((article) => <a href={article?.canonical_url} target="_blank"><span>{article?.source_name}</span>{article?.title}</a>)}</div></section>
  </main>
</BaseLayout>

