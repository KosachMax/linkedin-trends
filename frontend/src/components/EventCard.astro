---
import type { Article, DigestEvent } from "../lib/types";
interface Props { event: DigestEvent; articles: Article[]; digestId: string; date: string }
const { event, articles, digestId, date } = Astro.props;
const sources = event.article_ids.map((id) => articles.find((article) => article.id === id)).filter(Boolean) as Article[];
const tone = event.importance >= 9 ? "critical" : event.importance >= 7 ? "high" : event.importance >= 4 ? "medium" : "low";
const base = import.meta.env.BASE_URL;
const statusLabels: Record<string, string> = { new: "Новое", updated: "Обновлено", disputed: "Есть расхождения", completed: "Завершено" };
const categoryLabels: Record<string, string> = { world: "Мир", politics: "Политика", economics: "Экономика", economy: "Экономика", conflict: "Конфликты", diplomacy: "Дипломатия", energy: "Энергетика", ai: "ИИ", research: "Исследования", python: "Python", backend: "Разработка", club: "Клуб", transfers: "Трансферы", matches: "Матчи", injuries: "Травмы", russia: "Россия" };
const icon = tone === "critical" ? "🔥" : tone === "high" ? "🌍" : tone === "medium" ? "⚙️" : "•";
const importanceLabel = event.importance.toFixed(1).replace(".", ",");
---
<article class={`event-card ${tone}`} data-event-category={event.category}>
  <details>
    <summary class="event-summary">
      <span class="event-icon">{icon}</span>
      <div class="event-main">
        <div class="event-meta">
          <span class="status">{statusLabels[event.status] || event.status}</span>
          <span class="category">{categoryLabels[event.category] || event.category}</span>
          <span class="importance"><i></i>{importanceLabel}</span>
        </div>
        <h2>{event.title}</h2>
        <p>{event.brief}</p>
        <div class="event-footer">
          <span>{sources.length} {sources.length === 1 ? "источник" : sources.length < 5 ? "независимых источника" : "независимых источников"}</span>
          <span>{new Date(event.updated_at).toLocaleTimeString("ru-RU", { hour: "2-digit", minute: "2-digit" })}</span>
        </div>
        <span class="expand-label">История, контекст и источники <i>⌄</i></span>
      </div>
    </summary>
    <div class="event-details">
      <div class="detail-reading-column">
        <section class="detail-callout"><h3>Кратко</h3><p>{event.brief}</p></section>
        <section class="detail-callout"><h3>Расширенный контекст</h3><p>{event.context}</p><p>{event.why_it_matters}</p></section>
        <details class="detail-toggle">
          <summary>История события <span>⌄</span></summary>
          <div class="toggle-content">
            <p><time>{new Date(event.first_seen_at).toLocaleString("ru-RU")}</time> Событие впервые появилось в дайджесте.</p>
            {event.updates.map((update) => <p><time>{new Date(update.at).toLocaleString("ru-RU")}</time> {update.summary}</p>)}
          </div>
        </details>
        <details class="detail-toggle">
          <summary>Что подтверждено <span>⌄</span></summary>
          <div class="toggle-content"><ul>{event.facts.map((fact) => <li>{fact.text}</li>)}</ul></div>
        </details>
        <section class="sources-section">
        <h3>Источники</h3>
        <div class="article-links">
          {sources.map((source) => <a href={source.canonical_url} target="_blank" rel="noreferrer"><span>{source.source_name}</span>{source.title}</a>)}
        </div>
        </section>
        <a class="permalink" href={`${base}events/${digestId}/${date}/${event.slug}/`}>Открыть страницу события →</a>
      </div>
    </div>
  </details>
</article>
