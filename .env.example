# Google AI Studio (gemini-2.5-flash-lite, бесплатно)
GOOGLE_API_KEY=AIza...

# Obsidian vault path (абсолютный путь до папки в vault)
OBSIDIAN_VAULT_PATH=/Users/you/ObsidianVault/LinkedIn Trends

# Опционально: Dev.to API key (без него тоже работает, но лимит ниже)
DEVTO_API_KEY=

# Reddit OAuth (нужен для работы с GitHub Actions — публичный API заблокирован)
# Получить: https://www.reddit.com/prefs/apps → создать "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# The Guardian API key (новостной пайплайн)
# Получить: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
